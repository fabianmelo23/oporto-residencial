DATABASE_FILE=./data/database.local.json
PORT=3000
# Set to true to only allow on-duty guards to log in
ENFORCE_STAFF_DUTY=false

# Session lifetime (America/Bogota app; values in minutes/hours)
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15

# Comma-separated allowed browser origins (empty = allow any, demo-friendly)
# CORS_ORIGINS=https://oporto-residencial-production.up.railway.app

# Railway (production): attach a Volume mounted at /data and set:
# DATABASE_FILE=/data/database.json
# Without a volume, every redeploy wipes residents/visits/reservations/etc.
